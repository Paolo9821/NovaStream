{
  "$schema": "https://rork.com/schema/rork.json",
  "apps": [
    {
      "name": "NovaStream",
      "path": "android-novastream",
      "framework": "kotlin"
    },
    {
      "name": "NovaStream Licenses",
      "path": "web-novastream",
      "framework": "web"
    },
    {
      "name": "Functions",
      "path": "functions",
      "framework": "cloudflare"
    },
    {
      "name": "NovaStream Promo",
      "path": "motion-novastream",
      "framework": "web",
      "settings": {
        "kind": "motion-video"
      }
    },
    {
      "name": "NovaStream YouTube",
      "path": "motion-youtube",
      "framework": "web",
      "settings": {
        "kind": "motion-video"
      }
    }
  ]
}
