{
  "$schema": "https://rork.com/schema/rork.json",
  "apps": [
    {
      "name": "NovaStream",
      "path": "android-novastream",
      "framework": "kotlin"
    },
    {
      "name": "NovaStream Licenses",
      "path": "web-novastream",
      "framework": "web"
    },
    {
      "name": "Functions",
      "path": "functions",
      "framework": "cloudflare"
    },
    {
      "name": "NovaStream Promo",
      "path": "motion-novastream",
      "framework": "web",
      "settings": {
        "kind": "motion-video"
      }
    },
    {
      "name": "NovaStream YouTube",
      "path": "motion-youtube",
      "framework": "web",
      "settings": {
        "kind": "motion-video"
      }
    },
    {
      "name": "NovaStream Tutorial 1",
      "path": "motion-tutorial-1",
      "framework": "web",
      "settings": {
        "kind": "motion-video"
      }
    },
    {
      "name": "NovaStream Tutorial 2",
      "path": "motion-tutorial-2",
      "framework": "web",
      "settings": {
        "kind": "motion-video"
      }
    },
    {
      "name": "NovaStream Short 1",
      "path": "motion-short-1",
      "framework": "web",
      "settings": {
        "kind": "motion-video"
      }
    },
    {
      "name": "NovaStream Short 2",
      "path": "motion-short-2",
      "framework": "web",
      "settings": {
        "kind": "motion-video"
      }
    },
    {
      "name": "NovaStream iOS",
      "path": "ios-novastream",
      "framework": "swift",
      "settings": {
        "swiftSibling": false,
        "displayName": "Nova Stream IPTV",
        "iosBundleId": "app.rork.novastream"
      }
    }
  ]
}